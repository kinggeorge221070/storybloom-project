# Copy to .env.local for local function development. Never commit real values.
# Supabase project URL and publishable/anon key are public client configuration;
# only place them in the browser when the client is wired with Row Level Security.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# Server-side only. Configure with `supabase secrets set`, never in browser code.
PAYSTACK_SECRET_KEY=sk_test_REPLACE_WITH_YOUR_PAYSTACK_TEST_SECRET
